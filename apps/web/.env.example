# RadarPro apps/web -- local environment configuration.
# Copy this file to `.env.local` (already git-ignored, see .gitignore's
# "Env / secrets" section) and fill in real values there. Never commit a
# real key into this file or any other tracked file.

# Rainbow Weather (doc.rainbow.ai) precipitation tile overlay -- optional,
# user-supplied API key (S09b). Per GLOBAL_CONTRACT's provider rules this is
# an optional keyed provider that must fail independently: leave this blank
# and the app builds/runs fully, with the Rainbow overlay toggle visibly
# present but disabled/marked "not configured" instead of missing or
# crashing. See src/rainbow/config.ts.
VITE_RAINBOW_API_KEY=
